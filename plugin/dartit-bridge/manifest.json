{
  "manifest_version": 3,
  "name": "DartIt to DartCounter Bridge",
  "version": "1.0",
  "description": "Captures dartit.net detect responses and forwards each throw to the local DartCounter site for auto-scoring.",
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": ["tabs"],
  "host_permissions": [
    "https://dartit.net/*",
    "https://vis.dartit.net/*",
    "http://localhost/*",
    "http://192.168.178.92/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://dartit.net/*"],
      "js": ["injected.js", "dartit-content.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["http://localhost/*", "http://192.168.178.92/*"],
      "js": ["dartcounter-content.js"],
      "run_at": "document_idle"
    }
  ]
}
